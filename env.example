# Copy to .env for local dev:  cp .env.example .env
# In production, set these in your host's dashboard (Railway/Render/Fly).

# --- Twilio ---
# Console > Account Info > Auth Token. Required in production so the webhook
# can verify that incoming requests really come from Twilio.
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Verify the X-Twilio-Signature header. Keep "true" in production.
# Set "false" only for local testing (curl/Postman) without a real signature.
VALIDATE_TWILIO_SIGNATURE=true

# Recommended in production: the exact public webhook URL you paste into
# Twilio, e.g. https://your-app.up.railway.app/sms
# Leave blank locally; the app will reconstruct it from request headers.
PUBLIC_URL=

# --- Abuse safeguards (protect a leaked number from unlimited usage) ---
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_PER_DAY=100

# --- Optional ---
HTTP_TIMEOUT=8
LOG_LEVEL=INFO
